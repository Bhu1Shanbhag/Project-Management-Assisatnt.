# =============================================================
# AI Project Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Options: "openai" | "azure"
LLM_PROVIDER=azure

# ── OpenAI (used when LLM_PROVIDER=openai) ────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── Azure OpenAI (used when LLM_PROVIDER=azure) ──────────────
AOAI_CHAT_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_CHAT_KEY=your-azure-openai-key-here
AOAI_CHAT_DEPLOYMENT=gpt-4o
AOAI_API_VERSION_GPT=2024-08-01-preview

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=project_intelligence

# ── ChromaDB ─────────────────────────────────────────────────
CHROMADB_PATH=./chroma_store

# ── GitHub ───────────────────────────────────────────────────
# Optional default PAT (can also be entered per project in the UI)
GITHUB_PAT=your-github-personal-access-token

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=your-random-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── App ──────────────────────────────────────────────────────
APP_NAME=AI Project Intelligence Platform
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

